// REV7 physical constraints: Tang Mega NEO Dock 31004 / GW5AT-60B PG484A.
// Reconciled with user REV7 BL616 shared-SPI pin report on 2026-10-12.
// Source DOCX SHA256: b825dcb9ec5977368fb3503f4152dda648affd0057b340e84ecfc1392e4fde83
// Top: instrument_board_stage11_rev7. BL616 is the sole shared-SPI master.
// External encoder/SPI pull-ups: NONE here. EX_KEY.2: LVCMOS15 + pull-up.
// Enable CPU pins as GPIO in the project for AA19/AB20.
// REV8 LED: J13-1 / E14, direct non-inverted data, eight external LEDs.
// Encoder2 B=AB21 and switch=AB22 follow the confirmed board test, not DOCX encoder rows.

IO_LOC "adc_cs_n" R18;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "adc_sclk" T18;
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "adc_mosi" P16;
IO_PORT "adc_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "adc_miso" R17;
IO_PORT "adc_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "enc1_a" AA19;
IO_PORT "enc1_a" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "enc1_b" AB20;
IO_PORT "enc1_b" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "enc1_sw_n" AA20;
IO_PORT "enc1_sw_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "enc2_a" AA21;
IO_PORT "enc2_a" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "enc2_b" AB21;
IO_PORT "enc2_b" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "enc2_sw_n" AB22;
IO_PORT "enc2_sw_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "ws2812_data" E14;
IO_PORT "ws2812_data" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "mcu_spi_sck" V15;
IO_PORT "mcu_spi_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "mcu_spi_mosi" Y16;
IO_PORT "mcu_spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "mcu_spi_miso" AA15;
IO_PORT "mcu_spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "mcu_sd_cs_n" W15;
IO_PORT "mcu_sd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "mcu_cs1_n" W14;
IO_PORT "mcu_cs1_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "mcu_cs2_n" AB15;
IO_PORT "mcu_cs2_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "rst_n" Y12;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "audio_bclk" Y17;
IO_PORT "audio_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "audio_lrck" AB17;
IO_PORT "audio_lrck" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "audio_din" AA16;
IO_PORT "audio_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "pa_disable" AB16;
IO_PORT "pa_disable" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// DVI-compatible TMDS through Dock J29, existing native TLVDS_OBUF outputs.
// Dock schematic Rev1.4 page7 maps these FPGA balls to DVI nets on page15.
// Official 60K cam_dvi NEO_DOCK.cst uses positive-port P,N pair constraints.
// IO_TYPE is selected by the existing TLVDS_OBUF primitive, not LVCMOS33.
// Lane0=blue, lane1=green, lane2=red, lane3=forwarded clock.
IO_LOC "video_p[0]" J14,H14;
IO_PORT "video_p[0]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "video_p[1]" J15,H15;
IO_PORT "video_p[1]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "video_p[2]" K17,J17;
IO_PORT "video_p[2]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "video_p[3]" G15,G16;
IO_PORT "video_p[3]" PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
// video_n[0..3] are the OB legs of these same four TLVDS_OBUF pairs.
// Do not independently place the negative legs or add LVCMOS IO_TYPE to them.
// No Dock KEY0/KEY1 octave constraints: REV7 uses EC11 press inputs.
// No power/GND/analog FSR/unused NC/HDMI DDC/CEC/HPD constraints.

// Inactive alternative only; current top uses EC11 switches for octave keys.
// IO_LOC "octave_up_n" AA13;
// IO_PORT "octave_up_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
// IO_LOC "octave_down_n" AB13;
// IO_PORT "octave_down_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
