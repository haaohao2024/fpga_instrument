// Tang Mega 60K + NEO Dock 31004. GW5AT-LV60PG484AC1/I0 (60B).
// Top: instrument_board_top. Physical constraints reviewed 2026-09-24.
// Preserve the approved active-low reset/keys and internal debounce RTL.
// KEY0/1/2 are BANK9, 1.5V; they are NOT 3.3V inputs on the 60K board.
// Sources: 60K Dock schematic Rev1.4 pp6/7/9/10/18/19;
// Sipeed TangMega-60K-example/pmod_led_neo/src/pmod_led.cst and README.
// REQUIRED IDE setting, separate from CST:
// Project > Configuration > Place & Route > Dual-Purpose Pin > CPU as regular IO.
// Tcl equivalent: set_option -use_cpu_as_gpio 1
// This releases P19/R19/T21/U21 for user IO. A CST cannot set this project option.

// BANK7, onboard 50MHz oscillator (not MS5351/AB12).
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// BANK9, internal pull-ups to 1.5V. Buttons short to GND when pressed.
// KEY2 = reset, KEY1 = octave up, KEY0 = octave down.
IO_LOC "rst_n" Y12;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=1.5;
IO_LOC "octave_up_key_n" AB13;
IO_PORT "octave_up_key_n" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=1.5;
IO_LOC "octave_down_key_n" AA13;
IO_PORT "octave_down_key_n" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=OFF BANK_VCCIO=1.5;

// BANK7, MCP3008 powered at 3.3V. Enable CPU as regular IO (see above).
// J9-11=CLK, J9-12=DOUT, J9-9=DIN, J9-10=CS.
IO_LOC "adc_sclk" P19;
IO_PORT "adc_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "adc_dout" R19;
IO_PORT "adc_dout" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "adc_din" T21;
IO_PORT "adc_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "adc_cs_n" U21;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// BANK1, one external 3.3V EC11: J13-5=S1, J13-6=S2.
// J13-11 is 5V, NOT the EC11 VCC supply. Use J9-1/2 for 3.3V.
IO_LOC "ec11_s1" B13;
IO_PORT "ec11_s1" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ec11_s2" C13;
IO_PORT "ec11_s2" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// BANK7, onboard PT8211 and amplifier. No external jumpers required.
IO_LOC "dac_bck" Y17;
IO_PORT "dac_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "dac_ws" AB17;
IO_PORT "dac_ws" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "dac_din" AA16;
IO_PORT "dac_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// RTL keeps PA_EN high during reset, low during normal operation.
IO_LOC "pa_en" AB16;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
